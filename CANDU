% ======================================================================
%  CANDU-6 - pelny rdzen 3D (Serpent 2)
%  Struktura plikow (od najmniejszego do najwiekszego):
%    materials      - materialy i dane termiczne
%    fuelrod        - pret paliwowy na cala dlugosc kanalu (uniwersum F)
%    channel        - wiazka 37-pretowa (BUN) i kanal paliwowy (CH)
%    core           - siatka 380 kanalow (CORE) i geometria glowna (0)
% ======================================================================

include "materials"
include "fuelrod"
include "channel"
include "core"

/******************
 * Run parameters *
 ******************/

% --- Warunek brzegowy: 1 = proznia (neutron opuszczajacy geometrie ginie)

set bc 1

% --- Populacja: <neutrony/cykl> <cykle aktywne> <cykle nieaktywne>

set pop 1000 100 20

% --- Moc cieplna CANDU-6 (2064 MWt)

set power 2.064E9

% --- Wylaczenie generowania stalych grupowych (niepotrzebne, oszczedza czas)
%     Bez tej opcji Serpent domyslnie tworzy stale grupowe (usrednia parametry
%     jadrowe dla przedzialow energii neutronow) na potrzeby zewnetrznych kodow dyfuzyjnych.

set gcu -1

/******************
 * Plots          *
 ******************/

% plot <typ> <nx> <ny> <pozycja> <min1> <max1> <min2> <max2>
% typ: 1 = yz, 2 = xz, 3 = xy;  pozycja = wspolrzedna plaszczyzny ciecia

% --- Caly rdzen xy, ciecie w srodku wiazki 7 (z = 24.765)

plot 3 1000 1000 24.765  -400 400  -400 400

% --- Zblizenie na jeden kanal (srodek kanalu: x = y = 14.2875)

plot 3 800 800 24.765  0.0 28.575  0.0 28.575

% --- Caly rdzen xz przez rzad kanalow y = 14.2875

plot 2 1000 800 14.2875  -400 400  -310 310

% --- Zblizenie xz na styk wiazek 6 i 7 (z = 0) - widac zatyczki

plot 2 800 800 14.2875  0.0 28.575  -15 15

% --- Mapa rozkladu rozszczepien i strumienia (xy i xz)

mesh 3 500 500
mesh 2 500 500

/******************
 * Detectors      *
 ******************/

% --- Moc kanalowa: siatka detektora pokrywa sie z siatka rdzenia
%     (28 x 28 binow po 28.575 cm, od -400.05 do 400.05)
%     dr -8 = energia z rozszczepienia, dm fuel = licz tylko w paliwie

det ChPower  dr -8 void  dm fuel  dx -400.05 400.05 28  dy -400.05 400.05 28

% --- Osiowy rozklad mocy: 12 binow = 12 wiazek

det AxPower  dr -8 void  dm fuel  dz -297.18 297.18 12

% --- Strumien dwugrupowy (granica 0.625 eV) wzdluz osi x przez srodek rdzenia
%     ene <nazwa> 1 <granice energii w MeV>

ene G2 1  1.0E-11  6.25E-07  20.0

det FluxX  de G2  dx -380.0 380.0 76  dy -14.2875 14.2875 1  dz -24.765 24.765 1

/******************
 * Libraries      *
 ******************/

set acelib "/opt/serpent/xsdir/s2v0_jeff32.xsdata"
set declib "/opt/serpent/xsdir/s2v0_jeff311.dec"
set nfylib "/opt/serpent/xsdir/s2v0_jeff311.nfy"
